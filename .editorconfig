# EditorConfig — https://editorconfig.org
#
# SCOPE NOTICE — read before editing:
# These rules MUST stay consistent with .gitattributes, which is the authority
# for what actually lands in the repository. The two files were written to agree:
#
#   *.sh            -> LF   (.gitattributes `*.sh text eol=lf`)
#   *.cs/.axaml/... -> CRLF (.gitattributes `eol=crlf`)
#   *.yml           -> LF   (.gitattributes `*.yml text eol=lf`)
#
# There is deliberately NO global `[*] end_of_line = crlf`. A global CRLF rule
# would rewrite shell scripts to CRLF on Linux/macOS checkouts and break
# packaging/linux/publish-linux.sh. end_of_line is therefore set per glob below,
# mirroring .gitattributes exactly.
#
# Style is otherwise matched by hand in this repo; there is no analyzer or lint
# configuration, so these rules are advisory for editors/IDEs only.

root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = unset
max_line_length = off

# ── LF-only files (must match .gitattributes) ────────────────────────────────
[*.sh]
end_of_line = lf

[*.yml]
end_of_line = lf

[*.yaml]
end_of_line = lf

# ── CRLF files (the project's documented Windows convention) ─────────────────
[*.cs]
end_of_line = crlf

[*.axaml]
end_of_line = crlf

[*.csproj]
end_of_line = crlf

[*.sln]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.manifest]
end_of_line = crlf

# Markdown and JSON are intentionally left to the platform (end_of_line stays
# `unset` from the [*] block above), matching .gitattributes, which does not pin
# them either. They are CRLF on disk today; forcing it would flip every file on a
# fresh checkout for no tooling benefit.

# ── Editor behaviour ─────────────────────────────────────────────────────────
[*.{cs,axaml}]
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_prefer_braces = when_multiline:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_namespace_declarations = file_scoped:suggestion

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,ps1}]
indent_size = 4

# Generated by the .NET / Avalonia SDKs — never hand-edit.
[obj/**]
generated_code = true

[bin/**]
generated_code = true
