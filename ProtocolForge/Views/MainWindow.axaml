<suki:SukiWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProtocolForge.ViewModels"
        xmlns:models="using:ProtocolForge.Models"
        xmlns:sys="using:System"
        xmlns:svc="using:ProtocolForge.Services"
        xmlns:controls="using:ProtocolForge.Views.Controls"
        xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="ProtocolForge.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Classes="main-window"
        Icon="/Assets/protocol-forge.ico"
        Title="{DynamicResource L10n.App.Title}"
        TitleFontSize="12"
        IsMenuVisible="False"
        MinWidth="900" MinHeight="600">

    <!-- 标题栏图标:SukiWindow 模板的 PART_Logo 只渲染 LogoContent(SukiWindow.axaml:139-144),
         迁移到 SukiUI 后 App 从未设置它,标题栏左侧的协议图标丢失(旧版原生标题栏显示 .ico)。
         protocol-forge.png 是从 .ico 的 256×256 帧提取的 RGBA PNG;16px 与 12px 标题行高相称,
         内容盒 20px(38−18 模板内边距)内上下各留 2px。 -->
    <suki:SukiWindow.LogoContent>
        <Image Source="/Assets/protocol-forge.png" Width="16" Height="16" />
    </suki:SukiWindow.LogoContent>

    <!-- SukiUI 7.0.1 的 SukiWindow 模板未包含 VisualLayerManager(标准 Window 模板内嵌),窗口树
         因此没有 LightDismissOverlayLayer,所有浮层(ContextMenu/Flyout/ComboBox 下拉/ToolTip)
         都无法「点击外部关闭」(实机报告:packet 列表右键菜单点哪儿都不消失、空列表也弹)。这里在
         内容外层补一个 VisualLayerManager 恢复轻量关闭层;EnableAdornerLayer=False 以免额外引入
         AdornerLayer 改变既有行为(停靠指示已由 App.axaml.cs 的 UseFloatingDockAdorner 走浮动层)。 -->
    <VisualLayerManager EnableAdornerLayer="False">
    <Grid Name="RootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- ════════════════ Menu Bar ════════════════ -->
        <Menu Grid.Row="0" Classes="main-menu">
            <MenuItem Classes="main-menu-item" Header="{DynamicResource L10n.Mnu.File}">
                <MenuItem Header="{DynamicResource L10n.Mnu.Open}" Click="OnOpenPcapClicked" InputGesture="Ctrl+O" />
                <MenuItem Header="{DynamicResource L10n.Mnu.Save}" Click="OnSavePcapClicked" InputGesture="Ctrl+S" />
                <MenuItem Header="{DynamicResource L10n.Mnu.Export}" Click="OnExportPcapClicked" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{DynamicResource L10n.Mnu.ResetMods}" Click="OnResetClicked" />
                <Separator />
                <MenuItem Header="{DynamicResource L10n.Mnu.Undo}" InputGesture="Ctrl+Z"
                          Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" />
                <MenuItem Header="{DynamicResource L10n.Mnu.Redo}" InputGesture="Ctrl+Y"
                          Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" />
                <Separator />
                <MenuItem Header="{DynamicResource L10n.Mnu.TsharkPath}" Click="OnPickTsharkClicked" />
                <Separator />
                <MenuItem Header="{DynamicResource L10n.Mnu.OpenSupportData}" Click="OnOpenLogDirClicked" />
                <Separator />
                <MenuItem Header="{DynamicResource L10n.Mnu.Exit}" Click="OnExitClicked" />
            </MenuItem>
            <MenuItem Classes="main-menu-item" Header="{DynamicResource L10n.Mnu.View}">
                <MenuItem Header="{DynamicResource L10n.Mnu.PacketList}" IsChecked="{Binding ShowPacketList, Mode=OneWay}"
                          Command="{Binding TogglePacketListCommand}" ToggleType="CheckBox" />
                <MenuItem Header="{DynamicResource L10n.Mnu.ProtocolTree}" IsChecked="{Binding ShowProtocolTree, Mode=OneWay}"
                          Command="{Binding ToggleProtocolTreeCommand}" ToggleType="CheckBox" />
                <MenuItem Header="{DynamicResource L10n.Mnu.HexEditor}" IsChecked="{Binding ShowHexEditor, Mode=OneWay}"
                          Command="{Binding ToggleHexEditorCommand}" ToggleType="CheckBox" />
                <Separator />
                <MenuItem Header="{DynamicResource L10n.Mnu.ResetLayout}" Click="OnResetLayoutClicked" />
            </MenuItem>
            <MenuItem Classes="main-menu-item" Header="{DynamicResource L10n.Mnu.Tools}">
                <MenuItem x:Name="MenuLanguage" Header="{DynamicResource L10n.Lang.Menu}">
                    <MenuItem x:Name="MenuLangZhCn" Header="{DynamicResource L10n.Lang.ZhCn}" Click="OnMenuLangZhCnClicked" ToggleType="CheckBox"/>
                    <MenuItem x:Name="MenuLangEnUs" Header="{DynamicResource L10n.Lang.EnUs}" Click="OnMenuLangEnUsClicked" ToggleType="CheckBox"/>
                </MenuItem>
                <Separator />
                <MenuItem x:Name="MenuTheme" Header="{DynamicResource L10n.Theme.Menu}">
                    <MenuItem Header="{DynamicResource L10n.Theme.System}" Tag="Default" Click="OnMenuThemeBaseClicked" ToggleType="CheckBox"/>
                    <MenuItem Header="{DynamicResource L10n.Theme.Light}" Tag="Light" Click="OnMenuThemeBaseClicked" ToggleType="CheckBox"/>
                    <MenuItem Header="{DynamicResource L10n.Theme.Dark}" Tag="Dark" Click="OnMenuThemeBaseClicked" ToggleType="CheckBox"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Classes="main-menu-item" Header="{DynamicResource L10n.Mnu.Help}">
                <MenuItem Header="{DynamicResource L10n.Mnu.About}" Click="OnAboutClicked" />
            </MenuItem>
        </Menu>

        <!-- ════════════════ Toolbar ════════════════ -->
        <Border Grid.Row="1" Name="ToolBarPanel"
                Background="{DynamicResource SukiStrongBackground}" Padding="6,0" BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
                <!-- Start Button:配色/前景走 SukiUI 语义 class(Success=主题绿,亮暗自适应、含 hover/pressed)。
                     不再硬编码 #4CAF50;保留紧凑定高 Padding/Height/FontSize(SukiUI 基础按钮 Padding=20,8 会在 26px 下定高裁字)。 -->
                <Button Grid.Column="0" Name="StartSendBtn" Classes="Success"
                        Command="{Binding ToolBar.StartSendCommand}"
                        IsEnabled="{Binding ToolBar.CanSend}"
                        Padding="10,3" Margin="2,0" Height="26" VerticalAlignment="Center"
                        FontSize="13">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource Icon.Play}" Width="12" Height="12" />
                        <TextBlock Text="{DynamicResource L10n.Btn.Start}" />
                    </StackPanel>
                </Button>

                <!-- Pause/Resume Button:按钮在「暂停↔继续」间切换,图标随之切换(发送中=⏸,已暂停=▶)。 -->
                <Button Grid.Column="1" Name="PauseSendBtn" Classes="Warning"
                        Command="{Binding ToolBar.TogglePauseSendCommand}"
                        IsEnabled="{Binding ToolBar.IsSending}"
                        Padding="10,3" Margin="2,0" Height="26" VerticalAlignment="Center"
                        FontSize="13">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource Icon.Pause}" Width="12" Height="12"
                                  IsVisible="{Binding !ToolBar.IsPaused}" />
                        <PathIcon Data="{StaticResource Icon.Play}" Width="12" Height="12"
                                  IsVisible="{Binding ToolBar.IsPaused}" />
                        <TextBlock Text="{Binding ToolBar.PauseButtonText}" />
                    </StackPanel>
                </Button>

                <!-- Stop Button -->
                <Button Grid.Column="2" Name="StopSendBtn" Classes="Danger"
                        Command="{Binding ToolBar.StopSendCommand}"
                        IsEnabled="{Binding ToolBar.IsSending}"
                        Padding="10,3" Margin="2,0" Height="26" VerticalAlignment="Center"
                        FontSize="13">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource Icon.Stop}" Width="12" Height="12" />
                        <TextBlock Text="{DynamicResource L10n.Btn.Stop}" />
                    </StackPanel>
                </Button>

                <!-- Auto-fix toggle -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <ComboBox Name="VlanModeCombo" Width="136" Classes="toolbar-combo" FontSize="12"
                              ItemsSource="{Binding ToolBar.VlanModes}"
                              SelectedItem="{Binding ToolBar.SelectedVlanOption}"
                              DisplayMemberBinding="{Binding Label}"
                              ToolTip.Tip="{DynamicResource L10n.Tip.Vlan}" />
                    <!-- 同 PacketListPaneView:TextBox 主题自带 Padding="10,8",定高下会裁字,故去纵向内边距 -->
                    <TextBox Name="VlanIdBox" Width="58" Height="26" MinHeight="26"
                             Padding="4,0" FontSize="12"
                             Text="{Binding ToolBar.VlanId, Mode=TwoWay}"
                             IsVisible="{Binding ToolBar.IsVlanIdVisible}"
                             ToolTip.Tip="{DynamicResource L10n.Btn.VlanId}" />
                </StackPanel>
                <CheckBox Grid.Column="4" Name="MultiNicCheckBox" Margin="4,0,0,0"
                          Content="{DynamicResource L10n.Btn.MultiNic}"
                          IsChecked="{Binding ToolBar.MultiNicSend}"
                          VerticalAlignment="Center"
                          FontSize="12"
                          ToolTip.Tip="{DynamicResource L10n.Tip.MultiNic}" />
                <CheckBox Grid.Column="5" Name="AutoFixCheckBox"
                          Content="{DynamicResource L10n.Btn.AutoFix}"
                          IsChecked="{Binding ToolBar.AutoFixFrames}"
                          VerticalAlignment="Center" Margin="12,0,4,0"
                          FontSize="12" ToolTip.Tip="{DynamicResource L10n.Tip.AutoFix}" />

                <!-- Send interval -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock Text="{DynamicResource L10n.Btn.Interval}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <NumericUpDown Value="{Binding ToolBar.SendIntervalMs}"
                                   Minimum="0" Maximum="60000" Increment="50"
                                   FormatString="0" Width="140" Height="26" />
                </StackPanel>

                <!-- Loop count -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4"
                            VerticalAlignment="Center" Margin="8,0,4,0">
                    <TextBlock Text="{DynamicResource L10n.Btn.Loops}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <NumericUpDown Value="{Binding ToolBar.LoopCount}"
                                   Minimum="1" Maximum="9999" Increment="1"
                                   FormatString="0" Width="120" Height="26" />
                </StackPanel>

                <!-- Sent/Failed Status -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="4,0,8,0"
                            IsVisible="{Binding ToolBar.IsSending}">
                    <TextBlock FontSize="12" Foreground="#4CAF50" FontWeight="SemiBold">
                        <Run Text="✓" /><Run Text="{Binding ToolBar.TotalSent}" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#F44336" FontWeight="SemiBold">
                        <Run Text="✗" /><Run Text="{Binding ToolBar.TotalFailed}" />
                    </TextBlock>
                </StackPanel>

                <!-- Network Adapter Dropdown -->
                <ComboBox Grid.Column="9" Name="NetworkAdapterCombo" Classes="toolbar-combo"
                          ItemsSource="{Binding ToolBar.AvailableInterfaces}"
                          SelectedItem="{Binding ToolBar.SelectedInterface}"
                          DisplayMemberBinding="{Binding DisplayName}"
                          FontSize="12" MinWidth="180"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          PlaceholderText="{DynamicResource L10n.Btn.PlaceholderAdapter}" />
                <Button Grid.Column="10" Margin="4,0,0,0" Height="26" Padding="8,0"
                        FontSize="12" VerticalAlignment="Center"
                        Content="{DynamicResource L10n.Btn.RescanAdapters}"
                        ToolTip.Tip="{DynamicResource L10n.Btn.TipRescanAdapters}"
                        Command="{Binding ToolBar.RefreshInterfacesCommand}" />
            </Grid>
        </Border>

        <!-- ════════════════ Tshark Warning Banner ════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource SukiWarningColor}" BorderBrush="{DynamicResource SukiWarningDarkColor}"
                BorderThickness="0,0,0,1" Padding="8,4"
                IsVisible="{Binding IsReadOnly}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TsharkWarning}"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SukiWarningForeground}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L10n.Banner.Text}"
                           FontSize="12" Foreground="{DynamicResource SukiWarningForeground}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ════════════════ Main Content (Dock) ════════════════ -->
        <!-- 停靠指示层走 Dock 库自带的浮动指示窗(App.axaml.cs 已设 UseFloatingDockAdorner):
             SukiUI 7.0.1 的窗口模板删除了 VisualLayerManager,窗口树中缺少 AdornerLayer
             宿主,常规吸附器路径(AdornerLayer.GetAdornerLayer → Children.Add)静默失效。 -->
        <DockControl Grid.Row="3" Name="MainDockControl"
                     Layout="{Binding Layout}"
                     Factory="{Binding Factory}" />

        <!-- ════════════════ Status Bar ════════════════ -->
        <Border Grid.Row="4" Background="{DynamicResource SukiStrongBackground}" Padding="8,4"
                BorderBrush="{DynamicResource SukiBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12" VerticalAlignment="Center" />
                    <ProgressBar Value="{Binding LoadProgress}" Minimum="0" Maximum="1"
                                 Width="160" Height="6"
                                 IsVisible="{Binding IsLoading}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18">
                    <TextBlock FontSize="12" Foreground="{DynamicResource SukiDisabledText}"
                               Text="{Binding FileDisplay}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource SukiDisabledText}"
                               IsVisible="{Binding HasUnsavedChanges}"
                               Text="{Binding ModifiedDisplay}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </VisualLayerManager>
</suki:SukiWindow>
