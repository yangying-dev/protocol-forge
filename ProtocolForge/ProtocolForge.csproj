<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.1.0-beta.1</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0-beta.1</InformationalVersion>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Windows keeps the single-file default; Linux packaging overrides this with PublishSingleFile=false. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Self-contained: bundles the .NET runtime — end users install nothing but Wireshark.
         If you flip back to false, users must install the .NET 8 Desktop Runtime themselves. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationIcon>Assets\protocol-forge.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="Services\" />
    <Folder Include="Views\Controls\" />
    <!-- Avalonia 12 automatically includes *.axaml. Explicitly include only
         the non-XAML assets here so custom dictionaries are not embedded twice. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.axaml" />
    <!-- Lang dictionaries are ALSO .NET manifest resources so the console
         verification harness (tests/pf-verify) can load them without Avalonia. -->
    <EmbeddedResource Include="Assets\Lang\*.json" />
    <!-- Offline HTML user manual ships as a real file (not embedded) so the
         Help menu can open it in the OS default browser on Windows/Linux/macOS.
         The whole publish dir is packaged, so this content file is included
         automatically by every packaging script. -->
    <Content Include="Manual\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- VS-style docking layout (wieslawsoltes/Dock). The unsuffixed 12.x lane
         tracks Avalonia 12; the .v11 lane exists for Avalonia 11 apps. -->
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.1.0.7" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" Version="12.1.0.13" />
    <!-- Cross-control theming (SukiUI) + matching chrome for the Dock panes
         (SukiUI.Dock). SukiUI.Dock pulls the Dock 12.0.0.2 lanes in transitively;
         the explicit 12.1.0.7 references above win, so no downgrade occurs. -->
    <PackageReference Include="SukiUI" Version="7.0.1" />
    <PackageReference Include="SukiUI.Dock" Version="7.0.1" />
  </ItemGroup>
</Project>
